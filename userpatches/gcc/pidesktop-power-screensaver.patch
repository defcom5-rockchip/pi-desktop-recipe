-#define BLANK_SCREEN_DEFAULT 300
+static void
+screensaver_setting_changed_cb (CcPowerPanel *self)
+{
+  /* "file" was written by someone else (the service, dconf): resync the selection */
+  screensaver_refresh_files (self);
+}
+
+static void
+screensaver_file_cb (CcPowerPanel *self)
+{
+  const char *file = "";
+  guint pos;
+
+  if (self->screensaver_updating || self->screensaver_settings == NULL)
+    return;
+
+  pos = adw_combo_row_get_selected (self->screensaver_file_row);
+  if (pos != GTK_INVALID_LIST_POSITION && pos > 0 && pos <= self->screensaver_files->len)
+    file = g_ptr_array_index (self->screensaver_files, pos - 1);
+
+  /* our own write must not re-enter screensaver_refresh_files() from inside notify::selected */
+  g_signal_handlers_block_by_func (self->screensaver_settings, screensaver_setting_changed_cb, self);
+  g_settings_set_string (self->screensaver_settings, "file", file);
+  g_signal_handlers_unblock_by_func (self->screensaver_settings, screensaver_setting_changed_cb, self);
+}
+
+static void
+screensaver_dir_changed_cb (CcPowerPanel      *self,
+                            GFile             *file,
+                            GFile             *other_file,
+                            GFileMonitorEvent  event_type)
+{
+  /* a file being copied in emits a stream of CHANGED events: rescan on the final hint instead */
+  if (event_type == G_FILE_MONITOR_EVENT_CHANGED)
+    return;
+  screensaver_refresh_files (self);
+}
+
+static void
+screensaver_open_folder_cb (CcPowerPanel *self)
+{
+  g_autofree char *dir = screensaver_dir ();
+  g_autoptr(GFile) file = NULL;
+  g_autoptr(GtkFileLauncher) launcher = NULL;
+
+  g_mkdir_with_parents (dir, 0755);
+  file = g_file_new_for_path (dir);
+  launcher = gtk_file_launcher_new (file);
+  gtk_file_launcher_launch (launcher, GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (self))),
+                            NULL, NULL, NULL);
+}
+
+static void
+screensaver_preview_cb (CcPowerPanel *self)
+{
+  const char *argv[] = { "systemctl", "--user", "kill", "--kill-whom=main", "-s", "USR1",
+                         SCREENSAVER_SERVICE, NULL };
+
+  g_spawn_async (NULL, (char **) argv, NULL,
+                 G_SPAWN_SEARCH_PATH | G_SPAWN_STDOUT_TO_DEV_NULL | G_SPAWN_STDERR_TO_DEV_NULL,
+                 NULL, NULL, NULL, NULL);
+}
 
