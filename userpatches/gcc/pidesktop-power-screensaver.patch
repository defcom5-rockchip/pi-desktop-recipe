+/* Pi-Desktop: the "Automatic Screen Blank" rows are replaced by the settings of the
+ * pidesktop-screensaver user service: Pi-Desktop uses a screensaver instead of
+ * blanking the screen. */
+#define SCREENSAVER_SCHEMA  "org.pidesktop.screensaver"
+#define SCREENSAVER_SERVICE "pidesktop-screensaver.service"
+
+static const char * const screensaver_exts[] = {
+  ".png", ".jpg", ".jpeg", ".webp", ".avif", ".gif", ".mp4", ".mkv", ".webm", ".mov", ".m4v", NULL
+};
+static const char * const screensaver_video_exts[] = { ".mp4", ".mkv", ".webm", ".mov", ".m4v", NULL };
+
+static char *
+screensaver_dir (void)
+{
+  /* the same folder the service reads: ~/Pictures/screensaver */
+  return g_build_filename (g_get_home_dir (), "Pictures", "screensaver", NULL);
+}
+
+static gboolean
+screensaver_has_ext (const char *lower_name, const char * const *exts)
+{
+  for (guint i = 0; exts[i] != NULL; i++)
+    if (g_str_has_suffix (lower_name, exts[i]))
+      return TRUE;
+  return FALSE;
+}
+
+static int
+screensaver_compare_names (gconstpointer a, gconstpointer b)
+{
+  g_autofree char *ka = g_utf8_collate_key_for_filename (a, -1);
+  g_autofree char *kb = g_utf8_collate_key_for_filename (b, -1);
+
+  return strcmp (ka, kb);
+}
+
+static char *
+screensaver_pretty_name (const char *basename)
+{
+  g_autofree char *lower = g_ascii_strdown (basename, -1);
+  g_autofree char *stem = g_strdup (basename);
+  char *dot = strrchr (stem, '.');
+
+  if (dot != NULL)
+    *dot = '\0';
+  g_strdelimit (stem, "-_", ' ');
+
+  return g_strdup_printf ("%s  (%s)", stem,
+                          screensaver_has_ext (lower, screensaver_video_exts)
+                          ? C_("screensaver file kind", "video")
+                          : C_("screensaver file kind", "picture"));
+}
+
