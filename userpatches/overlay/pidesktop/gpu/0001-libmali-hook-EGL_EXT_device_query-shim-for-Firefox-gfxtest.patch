+      if (!strcmp(procname, "eglQueryDeviceAttribEXT"))
+         return (__eglMustCastToProperFunctionPointerType)pidesktop_eglQueryDeviceAttribEXT;
+      return (__eglMustCastToProperFunctionPointerType)pidesktop_eglQueryDeviceStringEXT;
+   }
+
