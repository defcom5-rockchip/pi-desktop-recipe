# pidesktop-local-path URL — print a local path for a network URL (smb://, sftp://, ftp(s)://, nfs://, mtp://, afp://) that only
# the desktop's file manager knows how to read: kio-fuse on KDE, GVFS's FUSE mount on GNOME. Exit 1 when neither can.
# Used by /etc/mpv/scripts/pidesktop-netpath.lua for files dropped on mpv from a network location.
u=$1; [ -n "$u" ] || exit 1
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]; then
	p=$(busctl --user --timeout=20 call org.kde.KIOFuse /org/kde/KIOFuse org.kde.KIOFuse.VFS mountUrl s "$u" 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p')
	[ -n "$p" ] && { printf '%s\n' "$p"; exit 0; }
fi
p=$(python3 -c 'import sys, gi; from gi.repository import Gio; p=Gio.File.new_for_uri(sys.argv[1]).get_path(); print(p or "")' "$u" 2>/dev/null)
[ -n "$p" ] && { printf '%s\n' "$p"; exit 0; }
exit 1
