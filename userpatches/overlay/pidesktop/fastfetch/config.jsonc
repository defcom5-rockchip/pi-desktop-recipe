// /etc/fastfetch/config.jsonc — Plaid Pi 5.5 system-wide fastfetch
// Users override by creating ~/.config/fastfetch/config.jsonc.
// Logo: truecolor half-block tartan (works in any terminal, no sixel/kitty needed).
// Regenerate the art with plaid_logo.py (kept next to this file in the recipe).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "/usr/share/pi-desktop/fastfetch/plaid.ans",
    // no "width": fastfetch 2.57 measures the 36-column logo itself and ADDS a configured width on top, which
    // pushed the info column to column 78 and made the greeting 131 columns wide (it wrapped over the logo in any
    // terminal narrower than that, e.g. with Large Text). Without it the info starts at column 42 (97 wide in all).
    "height": 21,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  // orange keys (#E85020), cream title — the Plaid palette
  "display": {
    "color": { "keys": "38;2;232;80;32", "title": "38;2;243;226;184" },
    "separator": "  ",
    "key": { "width": 10 }
  },

  "modules": [
    { "type": "title" },
    { "type": "custom", "key": " ", "format": "// no snaps · no mirage · built to run 24/7 //" },

    { "type": "custom", "format": "{#1;38;2;232;80;32}// PLAID PI 5.5 //" },
    { "type": "command", "key": "DISTRO", "text": "sed -n '1{s/ \\(—\\|--\\{0,1\\}\\) built.*//;p}' /etc/pi-desktop-manifest.txt 2>/dev/null || echo 'Plaid Pi 5.5'" },
    { "type": "os",      "key": "BASE", "format": "{name} {version-id} {codename} · {arch}" },
    { "type": "host",    "key": "BOARD" },
    { "type": "kernel",  "key": "KERNEL" },
    { "type": "custom",  "key": "LANE", "format": "Armbian vendor kernel + Ubuntu userland" },
    { "type": "custom",  "key": "FORK", "format": "defcom5-rockchip" },
    { "type": "uptime",  "key": "UPTIME" },
    { "type": "packages","key": "PKGS" },
    { "type": "shell",   "key": "SHELL" },
    { "type": "de",      "key": "DE" },
    { "type": "wm",      "key": "WM" },
    { "type": "terminal", "key": "TERM", "format": "{pretty-name}" },

    { "type": "custom", "format": "{#1;38;2;232;80;32}// SCREEN - GPU //" },
    { "type": "display", "key": "DISPLAY" },
    { "type": "gpu",     "key": "GPU", "temp": true },
    { "type": "command", "key": "MALI", "text": "echo \"libmali $(dpkg-query -W -f='${binary:Package} ${Version}\\n' 'libmali-valhall-*' 2>/dev/null | head -1 | sed 's/libmali-valhall-//; s/^g610-//') · OpenGL ES 3.2\"" },

    { "type": "custom", "format": "{#1;38;2;232;80;32}// VIDEO - AUDIO //" },
    { "type": "command", "key": "VAAPI", "text": "echo \"rockchip-vaapi $(dpkg-query -W -f='${Version}' rockchip-vaapi 2>/dev/null) · HEVC/VP9/AV1/H.264 HW\"" },
    { "type": "command", "key": "MPP",   "text": "dpkg-query -W -f='${Version}' librockchip-mpp1 2>/dev/null | sed 's/+ds.*//'" },
    { "type": "command", "key": "AUDIO", "text": "echo \"PipeWire $(pipewire --version 2>/dev/null | awk 'NR==2{print $4}') · WirePlumber $(wireplumber --version 2>/dev/null | awk 'NR==2{print $4}')\"" },
    { "type": "sound",   "key": "SINK" },
    { "type": "bluetooth","key": "BT" },

    { "type": "custom", "format": "{#1;38;2;232;80;32}// SILICON //" },
    { "type": "cpu",     "key": "CPU", "temp": true },
    { "type": "memory",  "key": "MEM" },
    { "type": "swap",    "key": "SWAP" },
    { "type": "disk",    "key": "DISK", "folders": "/" },
    { "type": "localip", "key": "IP", "showIpv6": false },

    { "type": "custom", "format": "{#1;38;2;232;80;32}// ORANGE PI 5B - ROCKCHIP RK3588 - MALI G610 //" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
