# Pi-Desktop: Chromium 155 (xtradeb VA-API build) -> rockchip-vaapi -> MPP. Verified on BSP 6.1 for 8-bit and 10-bit VP9 (2026-09-21)
# and 8-bit HEVC on Plaid (2026-09-22). --render-node-override: rkr7.2 registers an RKNPU render node (renderD129) and Chromium's
# VA-API setup otherwise picks it ("Preferred drm_render_node not found, picking rknpu") -> no hardware decode. Render nodes are
# numbered in probe order (a Panthor image has rockchip-drm on 128, the NPU on 129, the GPU on 130), so pick by driver: the GPU
# node (panthor) on Mesa images, the display controller's (rockchip-drm) on libmali images, renderD128 if neither is there.
# JointMediaOptimizer:SrcMediaMultiBufferPreloadSeconds/60 (5.5): keep 60 s of a local or network-drive video ahead
# instead of 10 (Chromium caps it at 50 MiB); checked present in Chromium/Chrome 155. Unknown feature parameters are ignored.
_rn() { for r in /sys/class/drm/renderD*; do [ "$(basename "$(readlink "$r/device/driver" 2>/dev/null)")" = "$1" ] && { echo "/dev/dri/${r##*/}"; return; }; done; }
PIDESKTOP_RENDER_NODE=$(_rn panthor); PIDESKTOP_RENDER_NODE=${PIDESKTOP_RENDER_NODE:-$(_rn rockchip-drm)}; PIDESKTOP_RENDER_NODE=${PIDESKTOP_RENDER_NODE:-/dev/dri/renderD128}
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ozone-platform-hint=wayland --render-node-override=$PIDESKTOP_RENDER_NODE --enable-features=AcceleratedVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,PlatformHEVCDecoderSupport,JointMediaOptimizer:SrcMediaMultiBufferPreloadSeconds/60"
