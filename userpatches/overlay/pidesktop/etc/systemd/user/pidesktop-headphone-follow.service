[Unit]
Description=Pi-Desktop: move audio to the headphone jack on plug-in, and back on unplug
ConditionPathExists=/proc/asound/rockchipes8388
ConditionUser=!@system
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
ExecStart=/usr/local/bin/pidesktop-headphone-follow
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
