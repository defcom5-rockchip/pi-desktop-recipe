# Pi-Desktop: vendor codec service + 2D engine are root-only on an Armbian rootfs.
# VA-API clients (mpv, Chromium, Firefox) run as the desktop user, so grant the video group.
KERNEL=="mpp_service", MODE="0660", GROUP="video"
KERNEL=="rga", MODE="0660", GROUP="video"
KERNEL=="mpp-service", MODE="0660", GROUP="video"
