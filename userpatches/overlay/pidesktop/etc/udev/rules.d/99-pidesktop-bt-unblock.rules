# Pi-Desktop: systemd-rfkill can restore a stale soft-block onto the reborn hci0 rfkill; clear it on creation
# Only when the rfkill device appears (ACTION=="add"): without it the rule also fired on every block event and undid
# Bluetooth-off and airplane mode.
ACTION=="add", SUBSYSTEM=="rfkill", ATTR{type}=="bluetooth", ATTR{soft}="0"
