#!/bin/sh
# Plaid Pi: Firefox on the Mali blob. Firefox loads EGL and GL as libEGL.so(.1) / libGL.so(.1) and dlsym()s from them;
# in this private directory those names are libpidesktop-ffmali, our small library: it passes Firefox's EGL/GL calls to
# Arm's Mali driver (it depends on libmali-hook + libmali, like the libEGL stub in Rockchip's libmali package) and works
# around two video-import problems in that driver: the 8-bit NV12 chroma plane it refuses, and the 10-bit luma plane it
# imports as an integer texture (dark picture). Tested 2026-10-12, Firefox 157, 1080p: 8-bit H.264 and 8/10-bit VP9 and
# AV1 decode on the VPU. Source: /usr/share/pi-desktop/firefox/. Programs Firefox starts inherit this path. Wayland only.
export LD_LIBRARY_PATH="/usr/local/lib/pidesktop-firefox-mali${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export MOZ_ENABLE_WAYLAND=1
# Off switch for troubleshooting (quit Firefox first: a running Firefox ignores a new one's environment):
# PIDESKTOP_FFMALI=0 makes the library a pure pass-through; 10-bit is then hidden from Firefox's hardware decoder
# (software, correct colours) as before 5.0, and 8-bit falls back to software (Bug 2078820). The same happens if the
# library is missing, so a broken install never draws 10-bit dark.
case ${PIDESKTOP_FFMALI:-1} in
	0*) export RKVA_HIDE_10BIT=1 ;;
	*)  [ -f /usr/local/lib/pidesktop-firefox-mali/libpidesktop-ffmali.so.1 ] && [ -e /usr/lib/aarch64-linux-gnu/libmali.so.1 ] \
	        || export RKVA_HIDE_10BIT=1 ;;
esac
# DRM (6.0): Firefox loads Widevine from folders named in MOZ_GMP_PATH. Mozilla ships no Widevine for this platform, but
# Google Chrome's arm64 package carries one, which Firefox loads (same module interface; checked 2026-10-23 with Firefox
# 158: module loads, license request generated). When Chrome is installed, a folder of two links to Chrome's files is kept
# in the user's cache and named here; nothing is copied, the module stays Google's install under Google's licence. The
# matching prefs are in vaapi.js. The folder must sit under one named gmp-widevinecdm: Firefox's plugin process derives the
# library name from the parent folder's name minus "gmp-", and crashes ("Plugin file does not exist") on any other layout.
_wv=/opt/google/chrome/WidevineCdm
if [ -r "$_wv/manifest.json" ] && [ -r "$_wv/_platform_specific/linux_arm64/libwidevinecdm.so" ]; then
	_wvd="${XDG_CACHE_HOME:-$HOME/.cache}/pidesktop-firefox-widevine/gmp-widevinecdm/system-installed"
	if mkdir -p "$_wvd" 2>/dev/null && ln -sfn "$_wv/_platform_specific/linux_arm64/libwidevinecdm.so" "$_wvd/libwidevinecdm.so" 2>/dev/null \
	   && ln -sfn "$_wv/manifest.json" "$_wvd/manifest.json" 2>/dev/null; then
		case ":${MOZ_GMP_PATH:-}:" in *":$_wvd:"*) ;; *) export MOZ_GMP_PATH="$_wvd${MOZ_GMP_PATH:+:$MOZ_GMP_PATH}" ;; esac
	fi
	unset _wvd
fi
unset _wv
exec /usr/lib/firefox/firefox "$@"
