+// Normalised format with the same texel size as an integer one, or 0.
+static GLenum copy_target(GLint internal)
+{
+    switch (internal) {
+    case GL_R8UI:   return GL_R8;
+    case GL_RG8UI:  return GL_RG8;
+    case GL_R16UI:  return GL_R16;
+    case GL_RG16UI: return GL_RG16;
+    }
+    return 0;
+}
+
+static void target_upload_format(GLenum fmt, GLenum *format, GLenum *type)
+{
+    *format = (fmt == GL_R8 || fmt == GL_R16) ? GL_RED : GL_RG;
+    *type = (fmt == GL_R16 || fmt == GL_RG16) ? GL_UNSIGNED_SHORT
+                                              : GL_UNSIGNED_BYTE;
+}
+
+// (Re)create the ra_tex wrapper of plane n around its GL texture. An integer
+// texture (uint_fmt) must use NEAREST filters to be complete.
+static bool wrap_plane_tex(struct ra_hwdec_mapper *mapper, int n)
+{
+    struct dmabuf_interop_priv *p_mapper = mapper->priv;
+    struct vaapi_gl_mapper_priv *p = p_mapper->interop_mapper_priv;
+    GL *gl = ra_gl_get(mapper->ra);
+    bool integer = !!p->uint_fmt[n];
+
+    ra_tex_free(mapper->ra, &p_mapper->tex[n]);
+
+    gl->BindTexture(GL_TEXTURE_2D, p->gl_textures[n]);
+    gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER,
+                      integer ? GL_NEAREST : GL_LINEAR);
+    gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER,
+                      integer ? GL_NEAREST : GL_LINEAR);
+    gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    gl->BindTexture(GL_TEXTURE_2D, 0);
+
+    struct ra_tex_params params = {
+        .dimensions = 2,
+        .w = mp_image_plane_w(&p_mapper->layout, n),
+        .h = mp_image_plane_h(&p_mapper->layout, n),
+        .d = 1,
+        .format = integer ? p->uint_fmt[n] : p->planes[n],
+        .render_src = true,
+        .src_linear = !integer,
+    };
+
+    if (params.format->ctype != (integer ? RA_CTYPE_UINT : RA_CTYPE_UNORM))
+        return false;
+
+    p_mapper->tex[n] = ra_create_wrapped_tex(mapper->ra, &params,
+                                             p->gl_textures[n]);
+    return !!p_mapper->tex[n];
+}
