From 3b88c4d3efb00f369e427ff618f60568948eb0b7 Mon Sep 17 00:00:00 2001
From: defcom5-rockchip <286489597+defcom5-rockchip@users.noreply.github.com>
Date: Thu, 24 Sep 2026 20:49:49 -0700
Subject: [PATCH] phy: rockchip: samsung-hdptx: don't touch FFE registers while
 suspended

rk_hdptx_phy_configure() applies the FRL TxFFE level straight to the LANE
registers. It is reached from dw_hdmi_rockchip_encoder_atomic_check() via
phy_configure(), which takes no runtime-PM reference, so it also runs for
TEST_ONLY commits and while the output is off.

After an FRL output is disabled the PHY runtime-suspends and PCLK_HDPTX0 is
gated. On an Orange Pi 5B at 3840x2160@120 (FRL 10G x 4) a screen blank is
followed ~15-20 s later by the sink's standby HPD toggle; the compositor
re-lights the output, atomic_check calls phy_configure(), the FFE writes
hit the unclocked APB under the regmap spinlock and the SoC hangs with no
output. At TMDS rates the pixel clock is parented to the PHY PLL, which
keeps the PHY runtime-active, so the problem does not show there.

The FFE level only matters on a live link and FLT link training applies
it again after power-on, so skip the write unless the PHY is active, and
say so once in the log.

An LLM assistant (Claude, Anthropic) traced the call path, drafted this
change and its description; the hang and its timing were observed on real
hardware.

Assisted-by: LLM
---
 .../phy/rockchip/phy-rockchip-samsung-hdptx.c   | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/phy/rockchip/phy-rockchip-samsung-hdptx.c b/drivers/phy/rockchip/phy-rockchip-samsung-hdptx.c
index dbde0275b3ad..850e983d868a 100644
--- a/drivers/phy/rockchip/phy-rockchip-samsung-hdptx.c
+++ b/drivers/phy/rockchip/phy-rockchip-samsung-hdptx.c
@@ -2483,6 +2483,21 @@ static void rk_hdptx_phy_configure_ffe(struct phy *phy, u8 ffe_lv, u8 ffe_mode)
 	if (!(ffe_mode & FFE_DE_EMPHASIS_ENABLE_MASK))
 		de_emphasis = 0;
 
+	/*
+	 * phy_configure() reaches here from the HDMI encoder's atomic_check
+	 * (TEST_ONLY commits included) without a runtime-PM reference. After an
+	 * FRL output is disabled the PHY runtime-suspends and PCLK_HDPTX0 is
+	 * gated; a LANE register access then stalls the bus and hangs the SoC
+	 * (Orange Pi 5B at 3840x2160@120: blank, the sink's standby HPD toggle,
+	 * the compositor re-lights the output, board dead). The FFE level only
+	 * matters on a live link and FLT training applies it again after
+	 * power-on, so skip the write when the PHY is not active.
+	 */
+	if (pm_runtime_get_if_active(hdptx->dev, true) <= 0) {
+		dev_info_ratelimited(hdptx->dev, "phy not active, skipping ffe config (lv %u)\n", ffe_lv);
+		return;
+	}
+
 	regmap_update_bits(hdptx->regmap, LANE_REG(0304), LN_TX_DRV_POST_LVL_CTRL_MASK,
 			   FIELD_PREP(LN_TX_DRV_POST_LVL_CTRL_MASK, de_emphasis));
 	regmap_update_bits(hdptx->regmap, LANE_REG(0404), LN_TX_DRV_POST_LVL_CTRL_MASK,
@@ -2500,6 +2515,8 @@ static void rk_hdptx_phy_configure_ffe(struct phy *phy, u8 ffe_lv, u8 ffe_mode)
 			   FIELD_PREP(LN_TX_DRV_PRE_LVL_CTRL_MASK, pre_shoot));
 	regmap_update_bits(hdptx->regmap, LANE_REG(0605), LN_TX_DRV_PRE_LVL_CTRL_MASK,
 			   FIELD_PREP(LN_TX_DRV_PRE_LVL_CTRL_MASK, pre_shoot));
+
+	pm_runtime_put(hdptx->dev);
 }
 
 static int rk_hdptx_phy_configure(struct phy *phy, union phy_configure_opts *opts)
-- 
2.53.0

